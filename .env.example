# --- Required (MVP) ---

# Database
DATABASE_URL=postgresql://gitshipdone:gitshipdone@localhost:5432/gitshipdone
POSTGRES_USER=gitshipdone
POSTGRES_PASSWORD=gitshipdone
POSTGRES_DB=gitshipdone

# Auth (production refuses to boot without real values)
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret

# Encryption (exactly 32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# App
FRONTEND_URL=http://localhost:3000
PORT=3001

# Email (Resend) — password reset; logged to console when unset
RESEND_API_KEY=

# --- Optional feature flags (post-MVP surfaces, default off) ---
# Server-side flags. The frontend has matching VITE_FEATURE_* build-time flags.
FEATURE_AI=false
FEATURE_GITHUB=false
FEATURE_OAUTH=false
FEATURE_REMINDERS=false

# With FEATURE_REMINDERS on: set CRON_SECRET to disable in-process cron and
# trigger reminders from an external scheduler instead:
#   curl -X POST -H "Authorization: Bearer <CRON_SECRET>" <host>/api/jobs/reminders/run
CRON_SECRET=

# --- Only needed when the matching feature flag is on ---

# Google OAuth (FEATURE_OAUTH)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth login (FEATURE_OAUTH)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub OAuth repo access (FEATURE_GITHUB — separate OAuth App)
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=
